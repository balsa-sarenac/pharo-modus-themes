"
Light theme with a warm, ochre-tinted background.
"
Class {
	#name : #ModusOperandiTintedTheme,
	#superclass : #ModusOperandiTheme,
	#category : #'ModusThemes-Themes'
}

{ #category : #accessing }
ModusOperandiTintedTheme class >> themeName [

	^ 'Modus Operandi Tinted'
]

{ #category : #accessing }
ModusOperandiTintedTheme class >> variantName [

	^ #operandiTinted
]
