"
Like Modus Operandi, with a light ochre background and more colorful accents.

Make me current with `ModusOperandiTintedTheme beCurrent` or `ModusThemes load: #operandiTinted`.
"
Class {
	#name : #ModusOperandiTintedTheme,
	#superclass : #ModusOperandiTheme,
	#category : #'ModusThemes-Themes'
}

{ #category : #accessing }
ModusOperandiTintedTheme class >> variantName [

	^ #operandiTinted
]
