"
Light theme for blue-yellow color deficiency. Uses red and cyan in place of blue and yellow.
"
Class {
	#name : #ModusOperandiTritanopiaTheme,
	#superclass : #ModusOperandiTheme,
	#category : #'ModusThemes-Themes'
}

{ #category : #accessing }
ModusOperandiTritanopiaTheme class >> themeName [

	^ 'Modus Operandi Tritanopia'
]

{ #category : #accessing }
ModusOperandiTritanopiaTheme class >> variantName [

	^ #operandiTritanopia
]
