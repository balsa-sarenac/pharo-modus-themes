"
Modus Operandi optimized for blue-yellow color deficiency (tritanopia): red and cyan hues take the place of blue and yellow.

Make me current with `ModusOperandiTritanopiaTheme beCurrent` or `ModusThemes load: #operandiTritanopia`.
"
Class {
	#name : #ModusOperandiTritanopiaTheme,
	#superclass : #ModusOperandiTheme,
	#category : #'ModusThemes-Themes'
}

{ #category : #accessing }
ModusOperandiTritanopiaTheme class >> variantName [

	^ #operandiTritanopia
]
