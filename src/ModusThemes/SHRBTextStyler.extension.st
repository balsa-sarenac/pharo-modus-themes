Extension { #name : #SHRBTextStyler }

{ #category : #'*ModusThemes' }
SHRBTextStyler class >> modusOperandiStyleTable [
	"Syntax highlighting of the Modus Operandi theme, selectable on its own in the Settings browser."

	<styleTable: 'Modus Operandi'>
	^ ModusOperandiTheme styleTable
]

