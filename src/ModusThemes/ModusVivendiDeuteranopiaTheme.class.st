"
Modus Vivendi optimized for red-green color deficiency (deuteranopia): blue and yellow hues take the place of red and green.

Make me current with `ModusVivendiDeuteranopiaTheme beCurrent` or `ModusThemes load: #vivendiDeuteranopia`.
"
Class {
	#name : #ModusVivendiDeuteranopiaTheme,
	#superclass : #ModusVivendiTheme,
	#category : #'ModusThemes-Themes'
}

{ #category : #accessing }
ModusVivendiDeuteranopiaTheme class >> variantName [

	^ #vivendiDeuteranopia
]
