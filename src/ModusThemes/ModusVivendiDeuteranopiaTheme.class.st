"
Dark theme for red-green color deficiency. Uses blue and yellow in place of red and green.
"
Class {
	#name : #ModusVivendiDeuteranopiaTheme,
	#superclass : #ModusVivendiTheme,
	#category : #'ModusThemes-Themes'
}

{ #category : #accessing }
ModusVivendiDeuteranopiaTheme class >> themeName [

	^ 'Modus Vivendi Deuteranopia'
]

{ #category : #accessing }
ModusVivendiDeuteranopiaTheme class >> variantName [

	^ #vivendiDeuteranopia
]
