"
Dark theme with a black background.
"
Class {
	#name : #ModusVivendiTheme,
	#superclass : #PharoDarkTheme,
	#traits : 'TModusTheme',
	#classTraits : 'TModusTheme classTrait',
	#category : #'ModusThemes-Themes'
}

{ #category : #accessing }
ModusVivendiTheme class >> themeName [

	^ 'Modus Vivendi'
]

{ #category : #accessing }
ModusVivendiTheme class >> variantName [

	^ #vivendi
]
